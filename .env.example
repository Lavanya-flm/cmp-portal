# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/cmp_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logger ───────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Email (AWS SES) ──────────────────────────────────────────
EMAIL_API_KEY=your_aws_ses_api_key_here
EMAIL_API_ENDPOINT=https://5z96f7b2hb.execute-api.ap-southeast-1.amazonaws.com/Prod/api/v1/email
EMAIL_FROM_ADDRESS=noreply@frontlinesedutech.com
EMAIL_REPLY_TO_ADDRESS=support@frontlinesedutech.com
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30
